# Copy to `.env` (never commit `.env`). No real credentials belong in this file.

APP_NAME=Atelier
ENVIRONMENT=development

# Local PostgreSQL (SQLAlchemy URL, psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://atelier:change-me@localhost:5432/atelier_dev

# true only behind a transaction-mode pooler (e.g. Supabase pooler, port 6543).
DATABASE_DISABLE_PREPARED_STATEMENTS=false

# Used ONLY by the test-suite. The database name MUST end in "_test": the suite refuses to
# run against anything else, so it can never touch real data.
TEST_DATABASE_URL=postgresql+psycopg://atelier:change-me@localhost:5432/atelier_test

# Supabase Auth. Tokens are verified in the backend (signature, issuer, audience, expiry).
# Preferred: asymmetric signing keys published as a JWKS.
SUPABASE_JWT_ISSUER=https://<your-project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Legacy projects only (HS256 shared secret). Leave empty when using the JWKS.
SUPABASE_JWT_SECRET=

# XP level progression: xp_required(L) = round(LEVEL_BASE_XP * (L-1) ** LEVEL_EXPONENT)
# Days back an occurrence may be recorded (0 = only today).
MAX_BACKFILL_DAYS=7

LEVEL_BASE_XP=100
LEVEL_EXPONENT=1.5
MAX_LEVEL=100
